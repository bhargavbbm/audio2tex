# Audio2TeX — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.

# Anthropic API key, used by backend/physics_parser.py's Claude pass to turn
# spoken physics into clean LaTeX. Get one at https://console.anthropic.com/
# If unset, Audio2TeX still works — it just falls back to the regex-only
# LaTeX conversion (lower quality on complex spoken math).
ANTHROPIC_API_KEY=sk-ant-your-key-here
